{
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{ "type": "command", "command": "$HOME/.config/agents/hooks/banned-phrases" }
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{ "type": "command", "command": "$HOME/.config/agents/hooks/banned-phrases" }
				]
			}
		]
	}
}
