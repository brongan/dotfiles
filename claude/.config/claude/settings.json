{
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"includeCoAuthoredBy": false,
	"permissions": {
		"allow": [
			"Bash(sqlite3 -readonly *ha.home.brongan.com*)",
			"Bash(curl *ha.home.brongan.com*)",
			"Bash(websocat *ha.home.brongan.com*)"
		],
		"defaultMode": "auto"
	},
	"model": "opus",
	"effortLevel": "high",
	"theme": "dark",
	"agentPushNotifEnabled": true,
	"skipAutoPermissionPrompt": true,
	"switchModelsOnFlag": true,
	"autoMemoryDirectory": "~/.config/claude/memory",
	"disableClaudeAiConnectors": true,
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "mcp__t3-code__delegate_task",
				"hooks": [
					{ "type": "command", "command": "$HOME/.config/agents/hooks/luna-wait" }
				]
			}
		]
	}
}
